.mi {
  display: flex;
  align-items: flex-start;
  background: #fff;
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 18rpx;
}
.mi-unread { background: #FBFDFF; }
.mi-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}
.mi-body { flex: 1; min-width: 0; margin: 0 18rpx; }
.mi-top { display: flex; align-items: center; justify-content: space-between; }
.mi-title { font-size: 28rpx; font-weight: 600; color: #1F2937; }
.mi-time { font-size: 20rpx; color: #C0C6D0; flex-shrink: 0; margin-left: 16rpx; }
.mi-content {
  font-size: 24rpx;
  color: #6B7280;
  margin-top: 10rpx;
  line-height: 1.5;
}
.mi-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #F0506E;
  margin-top: 10rpx;
  flex-shrink: 0;
}
