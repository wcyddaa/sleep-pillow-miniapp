.app-icon {
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  width: 100%;
}
.ai-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 26rpx;
}
.ai-badge {
  position: absolute;
  top: -6rpx;
  right: 2rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: #F0506E;
  color: #fff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  box-sizing: border-box;
}
.ai-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4B5563;
}
