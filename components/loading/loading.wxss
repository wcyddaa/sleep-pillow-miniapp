.loading-full {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.loading-inline {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}
.ld-spinner {
  width: 220rpx;
  height: 10rpx;
  border-radius: 8rpx;
  background: #EEF1F6;
  overflow: hidden;
}
.ld-small { width: 160rpx; }
.ld-bar {
  width: 70rpx;
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #4F8CFF, #6A5CFF);
  animation: loading-bar 1.1s ease-in-out infinite;
}
.ld-text {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}
@keyframes loading-bar {
  0% { transform: translateX(-80rpx); }
  100% { transform: translateX(230rpx); }
}
