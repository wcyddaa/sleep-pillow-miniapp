.ct { min-height: 100vh; }

/* 设备分组标题行 */
.group-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 8rpx 8rpx;
}
.group-label { font-size: 26rpx; font-weight: 600; color: #64748B; }

/* 「其他设备」右端刷新键 */
.group-refresh {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #2563EB;
  padding: 6rpx 18rpx;
  border: 1rpx solid #BFDBFE;
  border-radius: 999rpx;
  background: #fff;
}
.group-refresh-icon { display: inline-block; font-size: 28rpx; line-height: 1; }
.group-refresh-text { line-height: 1; }
.group-refresh.is-loading { color: #94A3B8; border-color: #E2E8F0; }
.group-refresh.is-loading .group-refresh-icon { animation: spin 0.9s linear infinite; }

/* 已连接设备（手机连耳机式一行） */
.ble-connected {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  border-radius: 20rpx;
  margin-bottom: 12rpx;
}
.ble-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.18);
  flex: none;
}
.ble-info { flex: 1; min-width: 0; }
.ble-name { font-size: 28rpx; font-weight: 600; color: #0F172A; }
.ble-sub { font-size: 22rpx; color: #64748B; margin-top: 2rpx; }
.ble-actions { display: flex; gap: 16rpx; flex: none; }
.ble-btn {
  font-size: 24rpx;
  color: #2563EB;
  padding: 8rpx 20rpx;
  border: 1rpx solid #BFDBFE;
  border-radius: 999rpx;
  background: #fff;
}

/* 附近蓝牙设备列表 */
.ble-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #EEF1F6;
}
.ble-item:last-child { border-bottom: none; }
.ble-item-icon { font-size: 44rpx; margin-right: 22rpx; }
.ble-item-main { flex: 1; min-width: 0; }
.ble-item-name { font-size: 30rpx; font-weight: 600; color: #1F2937; }
.ble-item-sub { font-size: 22rpx; color: #9CA3AF; margin-top: 6rpx; }
.ble-item-go {
  font-size: 24rpx;
  color: #2563EB;
  border: 1rpx solid #BFDBFE;
  border-radius: 999rpx;
  padding: 8rpx 26rpx;
  flex: none;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
.scan-tip { margin-top: 20rpx; }
.tip-text { font-size: 24rpx; color: var(--text-3); line-height: 1.7; }

/* 连接成功 -> 表单 */
.ok-row { display: flex; align-items: center; margin-bottom: 36rpx; }
.ok-badge {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--success-light); color: var(--success);
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; margin-right: 24rpx;
}
.ok-name { font-size: 30rpx; font-weight: 600; }
.ok-sub { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }
.wifi-pick { font-size: 22rpx; color: var(--primary); }

/* 进度 */
.pg-card { display: flex; flex-direction: column; align-items: center; padding: 70rpx 40rpx; margin-top: 40rpx; }
.pg-icon { font-size: 90rpx; }
.pg-text { margin-top: 26rpx; font-size: 30rpx; font-weight: 600; }
.pg-bar-track {
  width: 100%; height: 16rpx; border-radius: 10rpx;
  background: var(--line); margin-top: 40rpx; overflow: hidden;
}
.pg-bar {
  height: 100%; border-radius: 10rpx;
  background: var(--grad-primary);
  transition: width 0.5s ease;
}
.pg-pct { margin-top: 18rpx; font-size: 26rpx; color: var(--primary); font-weight: 600; }
.pg-steps { display: flex; width: 100%; justify-content: space-between; margin-top: 46rpx; }
.pg-step { font-size: 24rpx; color: var(--text-3); }
.pg-step.done { color: var(--primary); font-weight: 600; }

/* 完成 */
.done-card { display: flex; flex-direction: column; align-items: center; padding: 80rpx 40rpx; margin-top: 40rpx; }
.done-icon { font-size: 100rpx; }
.done-title { margin-top: 26rpx; font-size: 38rpx; font-weight: 700; }
.done-name { margin-top: 16rpx; font-size: 28rpx; color: var(--text-2); }
.done-sub { margin-top: 10rpx; font-size: 22rpx; color: var(--text-3); }
.done-go { width: 100%; margin-top: 60rpx; }
.done-back { width: 100%; margin-top: 24rpx; }
.done-caps { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; margin-top: 20rpx; }
.done-caps .cap { font-size: 20rpx; color: var(--text-3); background: #F3F5F9; border-radius: 8rpx; padding: 6rpx 14rpx; }

/* 云端状态提示（与 BLE 本地配网解耦，异步刷新） */
.done-cloud {
  margin-top: 18rpx; font-size: 22rpx; border-radius: 10rpx; padding: 10rpx 20rpx;
  background: #F3F5F9; color: var(--text-3);
}
.done-cloud.connecting { background: #EAF1FF; color: var(--primary); }
.done-cloud.online { background: #E7F8F1; color: var(--success); }
.done-cloud.timeout { background: #FFF4E5; color: #B26A00; }
