.ctrl { min-height: 100vh; }

/* 实时数据 */
.rt-head { display: flex; align-items: center; justify-content: space-between; }
.rt-title-row { display: flex; align-items: center; }
.rt-name { font-size: 28rpx; font-weight: 600; margin-right: 12rpx; }
.rt-tag {
  font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; margin-right: 12rpx;
}
.rt-tag-on { background: var(--success-light); color: var(--success); }
.rt-tag-off { background: #F3F4F6; color: var(--text-3); }
.rt-link { font-size: 24rpx; color: var(--primary); }

.rt-hero {
  display: flex; align-items: baseline;
  margin-top: 30rpx;
  background: linear-gradient(135deg, #F5F8FF, #FDF6FF);
  border-radius: 22rpx;
  padding: 30rpx;
}
.rt-hero-left { display: flex; align-items: center; flex: 1; }
.rt-hero-icon { width: 56rpx; height: 56rpx; border-radius: 16rpx; margin-right: 14rpx; align-self: center; }
.rt-hero-label { font-size: 28rpx; color: var(--text-2); font-weight: 600; }
.rt-hero-val { font-size: 88rpx; font-weight: 800; font-family: "DIN Alternate", sans-serif; line-height: 1; }
.rt-hero-unit { font-size: 24rpx; color: var(--text-3); margin-left: 8rpx; }

.rt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 20rpx; }
.rt-item { display: flex; flex-direction: column; align-items: center; background: #FAFBFD; border-radius: 18rpx; padding: 22rpx 0; }
.rt-val { font-size: 38rpx; font-weight: 700; font-family: "DIN Alternate", sans-serif; }
.rt-unit { font-size: 18rpx; color: var(--text-3); margin-top: 2rpx; }
.rt-label { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }

.rt-states { display: flex; gap: 16rpx; margin-top: 16rpx; }
.rt-state {
  flex: 1; display: flex; align-items: center;
  background: #FAFBFD; border-radius: 16rpx; padding: 18rpx 22rpx;
}
.rs-icon { width: 40rpx; height: 40rpx; border-radius: 12rpx; margin-right: 14rpx; }
.rs-label { flex: 1; font-size: 24rpx; color: var(--text-2); }
.rs-val { font-size: 28rpx; font-weight: 700; }

.rt-empty {
  margin-top: 30rpx;
  background: #FAFBFD; border-radius: 22rpx; padding: 48rpx 30rpx;
  display: flex; flex-direction: column; align-items: center;
}
.rt-empty-val { font-size: 60rpx; font-weight: 800; color: #D1D5DB; line-height: 1; font-family: "DIN Alternate", sans-serif; }
.rt-empty-tip { font-size: 22rpx; color: var(--text-3); margin-top: 14rpx; text-align: center; }

/* 实时区时间戳 */
.rt-updated { font-size: 22rpx; color: var(--text-3); text-align: right; margin-top: 16rpx; }

/* 「最近一帧」空态 */
.frame-empty {
  margin-top: 16rpx;
  background: #FAFBFD; border-radius: 16rpx; padding: 34rpx 24rpx;
  display: flex; align-items: center; justify-content: center;
}
.frame-empty .rt-empty-tip { margin-top: 0; }

/* 实时区状态值（打鼾 / 在床） */
.rt-state .rs-val { font-size: 30rpx; font-weight: 700; color: var(--text-2); }
.rt-state .rs-val.on { color: #F0506E; }

/* 数据来源小标签（蓝牙区 / 云端区 区分） */
.src-tag {
  font-size: 18rpx; font-weight: 400; color: var(--text-3);
  background: #F3F5F9; border-radius: 6rpx; padding: 2rpx 10rpx; margin-left: 12rpx;
}

.rt-links { display: flex; margin-top: 24rpx; }
.rt-link-btn {
  flex: 1; text-align: center; font-size: 26rpx; color: var(--primary);
  background: var(--primary-light); border-radius: 16rpx; padding: 18rpx 0;
}
.rt-link-btn:last-child { margin-left: 20rpx; }

/* 最近一天 */
.day-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 10rpx; }
.day-meta { font-size: 22rpx; color: var(--text-3); }
.day-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 16rpx; }
.day-item {
  display: flex; flex-direction: column; align-items: center;
  background: #FAFBFD; border-radius: 16rpx; padding: 22rpx 0;
}
.day-val { font-size: 36rpx; font-weight: 800; font-family: "DIN Alternate", sans-serif; }
.day-label { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; }

/* 控制 */
.sec-title { font-size: 30rpx; font-weight: 600; margin-bottom: 10rpx; }
.sec-hint { font-size: 22rpx; color: var(--text-3); margin-bottom: 18rpx; line-height: 1.5; }

.mode-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0; border-bottom: 2rpx solid var(--line);
}
.mode-row:last-child { border-bottom: none; }
.mode-info { display: flex; flex-direction: column; }
.mode-pill {
  padding: 12rpx 24rpx; border-radius: 16rpx;
  font-size: 26rpx; font-weight: 600;
}
.pill-off { background: #F3F4F6; color: var(--text-3); }
.pill-sim { background: var(--primary-light); color: var(--primary); }
.pill-real { background: #E7F8F1; color: var(--success); }
.ctl-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 0; border-bottom: 2rpx solid var(--line);
}
.ctl-row.col { flex-direction: column; align-items: stretch; }
.ctl-row:last-child { border-bottom: none; }
.ctl-info { display: flex; flex-direction: column; }
.ctl-label { font-size: 28rpx; color: var(--text); }
.ctl-sub { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }
.ctl-val { font-size: 26rpx; color: var(--primary); font-weight: 600; }

.slider-scale { display: flex; justify-content: space-between; font-size: 20rpx; color: var(--text-3); margin-top: -6rpx; }