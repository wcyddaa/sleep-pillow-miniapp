.dt { min-height: 100vh; }
.dt-head { display: flex; align-items: center; margin-bottom: 26rpx; }
.dt-icon { width: 92rpx; height: 92rpx; border-radius: 24rpx; margin-right: 24rpx; }
.dt-name { font-size: 32rpx; font-weight: 700; }
.dt-sub { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }

.dt-title { font-size: 28rpx; font-weight: 600; }
.dt-action { font-size: 22rpx; color: var(--primary); margin-left: 20rpx; }
.dt-hint { font-size: 20rpx; color: var(--text-3); margin-top: 10rpx; line-height: 1.6; }

.kv-list { border-top: 2rpx solid var(--line); }
.kv {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22rpx 0; border-bottom: 2rpx solid var(--line);
}
.kv:last-child { border-bottom: none; }
.k { font-size: 26rpx; color: var(--text-2); }
.v { font-size: 26rpx; color: var(--text); font-weight: 500; }
.fw-tag { margin-left: 16rpx; }

.caps { display: flex; flex-wrap: wrap; gap: 10rpx; margin: 20rpx 0; }
.cap { font-size: 20rpx; color: var(--primary); background: var(--primary-light); border-radius: 8rpx; padding: 8rpx 16rpx; }
.chain-flow { display: flex; flex-wrap: wrap; align-items: center; margin-top: 6rpx; }
.chain-node {
  font-size: 22rpx; color: var(--text-2);
  background: #F3F5F9;
  border-radius: 8rpx; padding: 8rpx 16rpx;
}
.chain-arrow { font-size: 22rpx; color: var(--text-3); margin: 0 8rpx; }

.raw-view { background: #1F2937; border-radius: 14rpx; padding: 20rpx; margin-top: 18rpx; max-height: 420rpx; }
.raw-text { color: #A7F3D0; font-size: 20rpx; line-height: 1.6; font-family: Menlo, Consolas, monospace; white-space: pre; }

.log-item { display: flex; padding: 20rpx 0; border-bottom: 2rpx solid var(--line); }
.log-item:last-child { border-bottom: none; }
.log-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin: 12rpx 18rpx 0 4rpx; flex-shrink: 0; }
.log-dot.info { background: var(--primary); }
.log-dot.warn { background: var(--warning); }
.log-dot.error { background: var(--danger); }
.log-content { font-size: 26rpx; color: var(--text); line-height: 1.6; }
.log-time { font-size: 20rpx; color: var(--text-3); margin-top: 6rpx; }

.ops { margin-top: 32rpx; }
.op-btn { margin-bottom: 24rpx; }
