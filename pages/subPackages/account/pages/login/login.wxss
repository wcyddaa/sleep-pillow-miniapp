.login { padding: 80rpx 40rpx 60rpx; }

.brand { margin-bottom: 60rpx; }
.brand-title { display: block; font-size: 44rpx; font-weight: 700; color: var(--text); }
.brand-sub { display: block; margin-top: 16rpx; font-size: 26rpx; color: var(--text-3); }

/* 微信主按钮 */
.wx-primary { padding: 48rpx 36rpx 36rpx; margin-bottom: 24rpx; }
.btn-wx-main {
  display: flex; align-items: center; justify-content: center;
  background: #07C160; color: #fff;
  border-radius: 24rpx; padding: 0;
  height: 100rpx; width: 100%; border: none; font-size: 0;
}
.btn-wx-main::after { border: none; }
.wx-icon-lg { font-size: 40rpx; margin-right: 16rpx; color: #fff; }
.wx-text-lg { font-size: 34rpx; font-weight: 600; color: #fff; }
.wx-hint-main {
  display: block; text-align: center;
  font-size: 22rpx; color: var(--text-3);
  margin-top: 20rpx;
}

/* 账号密码折叠 */
.form-toggle {
  display: flex; align-items: center; justify-content: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  gap: 8rpx;
}
.toggle-text { font-size: 26rpx; color: var(--primary); }
.toggle-arrow { font-size: 28rpx; color: var(--primary); }

.form { padding: 40rpx 34rpx 50rpx; }
.field { margin-bottom: 34rpx; position: relative; }
.field-label { display: block; font-size: 26rpx; color: var(--text-2); margin-bottom: 14rpx; }
.field-input {
  height: 96rpx; line-height: 96rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #F5F7FB;
  font-size: 30rpx; color: var(--text);
}
.eye-btn {
  position: absolute; right: 28rpx; bottom: 28rpx;
  font-size: 32rpx; line-height: 1; padding: 8rpx;
  color: var(--text-3);
}
.btn-submit {
  margin-top: 20rpx;
  height: 96rpx; line-height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary); color: #fff;
  font-size: 32rpx; font-weight: 600;
}

/* 底部提示 */
.footer-hint {
  margin-top: 48rpx;
  text-align: center;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.6;
  padding: 0 20rpx;
}
