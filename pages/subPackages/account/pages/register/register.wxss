.register { padding: 80rpx 40rpx 0; }

.brand { margin-bottom: 60rpx; }
.brand-title { display: block; font-size: 44rpx; font-weight: 700; color: var(--text); }
.brand-sub { display: block; margin-top: 16rpx; font-size: 26rpx; color: var(--text-3); }

.form { padding: 40rpx 34rpx 50rpx; }
.field { margin-bottom: 34rpx; }
.field-label { display: block; font-size: 26rpx; color: var(--text-2); margin-bottom: 14rpx; }
.field-input {
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: #F5F7FB;
  font-size: 30rpx;
  color: var(--text);
}
.btn-submit {
  margin-top: 20rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 24rpx;
  background: var(--primary);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}
.link {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
}